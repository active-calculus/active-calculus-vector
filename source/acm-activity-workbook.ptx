      \newcommand{\vC}{\vec{C}}
      \newcommand{\vd}{\vec{d}}
      \newcommand{\ve}{\vec{e}}
      \newcommand{\cursedihat}{\hat{\dot{i}}}
      \newcommand{\vi}{\hat{\imath}}
      \newcommand{\vj}{\hat{\jmath}}
      \newcommand{\vk}{\hat{k}}
      \newcommand{\vn}{\vec{n}}
      \newcommand{\vm}{\vec{m}}
      \newcommand{\vr}{\vec{r}}
      \newcommand{\vs}{\vec{s}}
