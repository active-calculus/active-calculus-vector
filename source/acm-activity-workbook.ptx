      \newcommand{\vG}{\vec{G}}
      \newcommand{\vH}{\vec{H}}
      \newcommand{\vR}{\vec{R}}
      \newcommand{\vT}{\vec{T}}
      \newcommand{\vN}{\vec{N}}
      \newcommand{\vL}{\vec{L}}
