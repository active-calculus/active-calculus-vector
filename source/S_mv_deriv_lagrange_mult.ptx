                </definition>

                <definition>
                  anchors=[(0.23,0.23),(0.4,0.5),(0.63,0.51),(0.6,0.85),(0.75,0.9)]
                </definition>
                <coordinates bbox="[-1.5,-1.5,1.5,1.5]">
                  <axes xlabel="x" ylabel="y" decorations="no"/>
                  <repeat parameter="c=0..4">
                    <implicit-curve function="f" k="contours[c]" stroke="#1A85FF" opacity="0.65" />
                    <label anchor="anchors[c]" alignment="n">
                      <m>
                        ${contours[c]}
                      </m>
                    </label>
                  </repeat>
                  <implicit-curve function="l1" k="56/9" stroke="#D41159"/>
                  <implicit-curve function="l2" k="-14" stroke="#D41159"/>
                  <label anchor="(-1.12,1.35)" alignment="e" rotate="-17">
                    <m>
                      g_1(x,y)=c_1
                    </m>
                  </label>
                  <label anchor="(-1.05,0.2)" alignment="w" rotate="-79">
                    <m>
                      g_2(x,y)=c_2
                    </m>
                  </label>
                  <point at="p1" p="(-3*sqrt(103)/36,-3/8)"/>
