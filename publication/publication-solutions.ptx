<publication>
  <source>
    <directories generated="../generated-assets-solutions"
		 />
    <version include="" />
  </source>
  <latex sides="two" print="yes" font-size="10" pageref="no">
    <page>
      <geometry>letterpaper,tmargin=.5in,bmargin=.3in,hmargin=.75in,includeheadfoot</geometry>
    </page>
    <worksheet formatted="no"/>
  </latex>
  <html>
    <baseurl href="https://activecalculus.org/multi/" />
  </html>
  <common>
    <!-- List Chapters and Sections in sidebar Table of Contents -->
    <tableofcontents level="3" />
    <exercise-divisional statement="yes" hint="no" answer="no" solution="yes"/>
    <exercise-project statement="yes" hint="no" answer="no" solution="yes" />
  </common>
  <numbering>
    <divisions chapter-start="9" />
    <projects distinct="yes" />
  </numbering>
  <webwork server="https://webwork-ptx.aimath.org"
  course="anonymous" password="anonymous"
	   user="anonymous"/>

</publication>
